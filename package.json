{
  "name": "language-model-training-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/platform",
    "apps/llm-gateway",
    "apps/catalog",
    "apps/labeling",
    "apps/agents",
    "apps/bff",
    "apps/telemetry",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings 'packages/*/src/**/*.test.ts' 'apps/*/src/**/*.test.ts'",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm test",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
