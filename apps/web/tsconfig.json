{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/core/*": [
        "../../packages/contracts/src/*"
      ],
      "@tsp/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@tsp/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@tsp/infra": [
        "../../packages/infra/src/index.ts"
      ],
      "@tsp/infra/*": [
        "../../packages/infra/src/*"
      ],
      "@tsp/agents": [
        "../agents/src/index.ts"
      ],
      "@tsp/agents/*": [
        "../agents/src/*"
      ],
      "@tsp/bff": [
        "../bff/src/index.ts"
      ],
      "@tsp/bff/*": [
        "../bff/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/infra/src/**/*.ts",
    "../agents/src/**/*.ts",
    "../bff/src/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
