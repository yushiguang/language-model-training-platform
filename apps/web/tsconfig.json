{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@sprint/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@sprint/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@sprint/platform": [
        "../../packages/platform/src/index.ts"
      ],
      "@sprint/platform-impl": [
        "../../packages/platform/src/config.ts"
      ],
      "@sprint/llm-gateway": [
        "../../apps/llm-gateway/src/index.ts"
      ],
      "@sprint/catalog": [
        "../../apps/catalog/src/index.ts"
      ],
      "@sprint/labeling": [
        "../../apps/labeling/src/index.ts"
      ],
      "@sprint/agents": [
        "../../apps/agents/src/index.ts"
      ],
      "@sprint/optimiser": [
        "../../apps/optimiser/src/index.ts"
      ],
      "@sprint/workflow": [
        "../../apps/workflow/src/index.ts"
      ],
      "@sprint/bff": [
        "../../apps/bff/src/index.ts"
      ],
      "@sprint/telemetry": [
        "../../apps/telemetry/src/index.ts"
      ],
      "@sprint/client-impl": [
        "./src/backend-api/in-process.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
