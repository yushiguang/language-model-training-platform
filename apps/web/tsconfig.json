{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@tsp/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@tsp/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@tsp/platform": [
        "../../packages/platform/src/index.ts"
      ],
      "@tsp/platform-impl": [
        "../../packages/platform/src/config.ts"
      ],
      "@tsp/llm-gateway": [
        "../../apps/llm-gateway/src/index.ts"
      ],
      "@tsp/catalog": [
        "../../apps/catalog/src/index.ts"
      ],
      "@tsp/labeling": [
        "../../apps/labeling/src/index.ts"
      ],
      "@tsp/agents": [
        "../../apps/agents/src/index.ts"
      ],
      "@tsp/bff": [
        "../../apps/bff/src/index.ts"
      ],
      "@tsp/telemetry": [
        "../../apps/telemetry/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
