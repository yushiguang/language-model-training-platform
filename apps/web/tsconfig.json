{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@yushiguang/sprint-contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@yushiguang/sprint-domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@yushiguang/sprint-platform": [
        "../../packages/platform/src/index.ts"
      ],
      "@yushiguang/sprint-platform-impl": [
        "../../packages/platform/src/config.ts"
      ],
      "@yushiguang/sprint-llm-gateway": [
        "../../apps/llm-gateway/src/index.ts"
      ],
      "@yushiguang/sprint-catalog": [
        "../../apps/catalog/src/index.ts"
      ],
      "@yushiguang/sprint-labeling": [
        "../../apps/labeling/src/index.ts"
      ],
      "@yushiguang/sprint-agents": [
        "../../apps/agents/src/index.ts"
      ],
      "@yushiguang/sprint-optimiser": [
        "../../apps/optimiser/src/index.ts"
      ],
      "@yushiguang/sprint-workflow": [
        "../../apps/workflow/src/index.ts"
      ],
      "@yushiguang/sprint-jobs": [
        "../../apps/jobs/src/index.ts"
      ],
      "@yushiguang/sprint-bff": [
        "../../apps/bff/src/index.ts"
      ],
      "@yushiguang/sprint-telemetry": [
        "../../apps/telemetry/src/index.ts"
      ],
      "@yushiguang/sprint-config": [
        "../../apps/config/src/index.ts"
      ],
      "@yushiguang/sprint-client-impl": [
        "./src/backend-api/in-process.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
